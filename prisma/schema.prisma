generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        String   @id @default(cuid())
  avatar    String
  nickname  String
  date      DateTime
  content   String
  imageList String[]
  videoList String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
